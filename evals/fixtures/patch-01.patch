diff --git a/src/config/theme.js b/src/config/theme.js
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/src/config/theme.js
@@ -0,0 +1,18 @@
+const THEMES = { light: 'light' };
+
+function createTheme(name) {
+  if (!THEMES[name]) {
+    throw new Error(`unknown theme: ${name}`);
+  }
+  return THEMES[name];
+}
+
+function ThemeFactory(name) {
+  return createTheme(name);
+}
+
+function ThemeProvider(name) {
+  return ThemeFactory(name);
+}
+
+module.exports = { ThemeProvider, THEMES };
