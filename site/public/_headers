# Baseline security headers for the static docs site.
# Applied by Cloudflare Workers Static Assets at the edge (author this in
# public/ so it is copied into the build output as dist/_headers).
#
# CSP notes:
# - Astro/Starlight ship inline theme scripts and inline style attributes, so
#   script-src/style-src need 'unsafe-inline' (static hosting has no nonce/hash
#   injection point in a _headers file).
# - Pagefind search compiles a same-origin WebAssembly module and spawns a
#   same-origin Worker, so script-src needs 'wasm-unsafe-eval' and worker-src
#   must allow 'self'.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), geolocation=(), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self'

# Astro emits content-hashed build assets under /_astro/ - cache them immutably.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
