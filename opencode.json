{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["agents-opencode"],
  "share": "disabled",
  "subagent_depth": 2,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000,
    "tail_turns": 6,
    "preserve_recent_tokens": 12000
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "permission": {
    "external_directory": "deny",
    "doom_loop": "deny"
  }
}
