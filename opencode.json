{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["agents-opencode"],
  "share": "disabled",
  "subagent_depth": 2,
  "compaction": {
    "prune": true
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "permission": {
    "external_directory": "deny",
    "doom_loop": "deny"
  }
}
