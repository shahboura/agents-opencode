{
  "name": "agents-opencode",
  "version": "4.2.0",
  "description": "OpenCode Agents: Intelligent AI assistants for software development. Features 10 specialized agents (including researcher for decision grounding and legal-advisor for license auditing and compliance), 28 on-demand skills delivering language coding standards and domain guidance, automated code review, documentation generation, OpenCode plugin compatibility, and cross-platform installation. Supports .NET, Python, TypeScript, Flutter, Go, Java, Node.js, React, Ruby, Rust, and SQL with plan-first execution and context-aware assistance.",
  "files": [
    "install.js",
    "THIRD_PARTY_NOTICES.md",
    "DEPRECATIONS.md",
    ".opencode/agents",
    ".opencode/commands",
    "!.opencode/commands/README.md",
    ".opencode/instructions",
    ".opencode/lib",
    ".opencode/plugins",
    ".opencode/skills",
    "opencode.json",
    "scripts/lib"
  ],
  "main": "./.opencode/plugins/agents-opencode.ts",
  "exports": {
    ".": "./.opencode/plugins/agents-opencode.ts",
    "./server": "./.opencode/plugins/agents-opencode.ts",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shahboura/agents-opencode.git"
  },
  "homepage": "https://agnts.elkodr.com/",
  "bugs": {
    "url": "https://github.com/shahboura/agents-opencode/issues"
  },
  "bin": {
    "agents-opencode": "install.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run doctor",
    "doctor": "node scripts/doctor.js",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore .github --ignore \"example/**\" --ignore \"dist/**\" --ignore \"handoff/**\" --ignore \"evals/reports/**\" --ignore \"site/node_modules\" --ignore \"site/dist\" --ignore \"site/.astro\"",
    "lint:md:fix": "markdownlint \"**/*.md\" --ignore node_modules --ignore .github --ignore \"example/**\" --ignore \"dist/**\" --ignore \"handoff/**\" --ignore \"evals/reports/**\" --ignore \"site/node_modules\" --ignore \"site/dist\" --ignore \"site/.astro\" --fix",
    "validate:agents": "node scripts/validate-agents.js",
    "validate:opencode-schema": "node scripts/validate-opencode-schema.js --strict",
    "validate:opencode-schema:v2": "node scripts/validate-opencode-schema.js --v2-strict",
    "validate:plugin-guards": "node scripts/plugin-guards.test.js",
    "validate:plugin-v2": "node scripts/plugin-v2.test.js",
    "validate:target": "node scripts/opencode-target.test.js",
    "validate:gate": "node scripts/gate/gate.test.js",
    "gate:freeze": "node scripts/gate/freeze.js",
    "gate:pass": "node scripts/gate/record-pass.js",
    "gate:lens": "node scripts/gate/lens-evidence.js",
    "quality:report": "node scripts/quality-report.js",
    "gate:quick": "node scripts/gate/freeze.js && node scripts/doctor.js && node scripts/gate/record-pass.js --verdict=PASS",
    "gate:check": "node scripts/gate/precommit-check.js",
    "gate:install": "node scripts/gate/install-hooks.js",
    "validate:commands": "node scripts/validate-command-matrices.js",
    "validate:inventory": "node scripts/validate-inventory.js",
    "graph:check": "node scripts/check-graph-freshness.js",
    "eval:agents": "node evals/harness/run-evals.js",
    "eval:agents:json": "node evals/harness/run-evals.js --json --out evals/reports/latest.json",
    "eval:agents:trend": "node scripts/compare-eval-trend.js --current evals/reports/latest.json --baseline evals/fixtures/eval-trend-baseline.json --out evals/reports/trend-summary.md",
    "validate:installer": "node scripts/test-installer.js",
    "validate:docs": "node scripts/validate-docs.js",
    "validate:docs:external": "node scripts/validate-docs.js --external",
    "validate:changelog": "node scripts/validate-changelog-labels.js",
    "validate:session": "node scripts/validate-session-state.js",
    "handoff:generate": "node scripts/generate-handoff.js --state state/session-state.json --out handoff/latest.md",
    "validate:context": "node scripts/check-context-size.js --check",
    "validate:npx": "node scripts/test-npx-integrity.js",
    "validate:all": "npm run doctor"
  },
  "devDependencies": {
    "markdownlint-cli": "^0.50.0"
  },
  "overrides": {
    "js-yaml": "^5.4.1",
    "markdown-it": "~14.3.1",
    "brace-expansion": "^5.0.12",
    "katex": "^0.18.2",
    "smol-toml": "^1.9.1"
  },
  "keywords": [
    "opencode",
    "ai-agents",
    "code-generation",
    "development-tools",
    "coding-standards",
    "code-review",
    "documentation",
    "multi-language",
    "dotnet",
    "python",
    "typescript",
    "flutter",
    "go",
    "java",
    "nodejs",
    "react",
    "ruby",
    "rust",
    "ci-cd",
    "automation"
  ],
  "author": "shahboura",
  "license": "MIT"
}
